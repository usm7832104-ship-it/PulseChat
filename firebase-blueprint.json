{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public profile record synced with Firebase Auth for Google Sign-In users.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "User display name",
          "minLength": 1,
          "maxLength": 80
        },
        "bio": {
          "type": "string",
          "description": "User status bio",
          "minLength": 0,
          "maxLength": 200
        },
        "avatarUrl": {
          "type": "string",
          "description": "Profile picture URL or data URI",
          "minLength": 0,
          "maxLength": 200000
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of update"
        }
      },
      "required": ["uid", "displayName", "bio", "avatarUrl", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Authenticated user profile synchronized on Google Sign-In"
    }
  }
}
